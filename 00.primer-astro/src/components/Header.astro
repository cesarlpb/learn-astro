<div id="header">
  <header>
    <ul>
      <li>
        <a href="/">Inicio</a>
      </li>
      <li>
        <a href="about">Acerca de</a>
      </li>
      <li>
        <a href="contact">Contacto</a>
      </li>
    </ul>
  </header>  
</div>

<style>
  #header {
    background-color: lightgray;
    position: absolute;
    top: 0;
    left:0;
    width: 100vw;
    padding: 1em;
    margin: 0;
    text-align: center;
    
    & ul {
      display: inline-flexbox; /* para alinear con margin auto */
      list-style: none;
      padding-left: 0;
      margin: 1em auto;
      
      & li {
        display: inline-block;
        margin: 0 1em;
        padding: 0;
        text-align: center;

        & a {
          display: block; /* Hace que el <a> ocupe todo el espacio del <li> */
          width: 100%;
          height: 100%;
          text-decoration: none;
          text-align: center;
          color: black;
          font-weight: 500;
          padding: 0.5em 1em;
        }
        & a:hover{
          background-color: rgba(255, 255, 255, 0.75);
        }
      }

    }
  }
</style>